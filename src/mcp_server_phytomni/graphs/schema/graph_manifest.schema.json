{
  "$defs": {
    "GraphEdgeManifest": {
      "description": "Serializable metadata for one graph edge.",
      "properties": {
        "conditional": {
          "default": false,
          "title": "Conditional",
          "type": "boolean"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "source"
      ],
      "title": "GraphEdgeManifest",
      "type": "object"
    },
    "GraphNodeManifest": {
      "description": "Serializable metadata for one graph node.",
      "properties": {
        "kind": {
          "default": "node",
          "enum": [
            "node",
            "subgraph",
            "boundary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "GraphNodeManifest",
      "type": "object"
    }
  },
  "$id": "https://phytomni.cn/schemas/graph_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Serializable structural manifest of one compiled LangGraph app.",
  "properties": {
    "graph_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Graph Id"
    },
    "classification": {
      "default": "unspecified",
      "enum": [
        "public",
        "internal",
        "unspecified"
      ],
      "title": "Classification",
      "type": "string"
    },
    "public_agent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Public Agent"
    },
    "lifecycle": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Lifecycle",
      "type": "array"
    },
    "subgraph_dependencies": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Subgraph Dependencies",
      "type": "array"
    },
    "remote_providers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Remote Providers",
      "type": "array"
    },
    "driver": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Driver"
    },
    "topology": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Topology"
    },
    "edges": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GraphEdgeManifest"
      },
      "title": "Edges",
      "type": "array"
    },
    "nodes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GraphNodeManifest"
      },
      "title": "Nodes",
      "type": "array"
    }
  },
  "title": "GraphManifest",
  "type": "object"
}
