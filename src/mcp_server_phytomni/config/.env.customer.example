# Customer relay-mode Bot: copy to .env and fill in the relay values.
#
# A relay-mode child Bot reaches the operator's upstream relay API for
# every model, retrieval, NL2SQL, BI, analysis, task, and OBS call, so
# it holds NO operator endpoints or secrets of its own. Only the
# PHYTOMNI_RELAY_* variables below are required; the 19 deployment
# endpoints and the backend secrets are resolved operator-side.
#
# Set PHYTOMNI_RELAY_MODE=1 so the import-time config validators skip
# the otherwise-required operator endpoints (see config/relay_mode.py
# and config/defaults.py). See README.md "Customer Relay Mode" and
# docs/reference/configuration.md "Relay Variables" for the full contract.

# --- Required ---
PHYTOMNI_RELAY_MODE=1
PHYTOMNI_RELAY_BASE_URL=https://relay.operator.example
PHYTOMNI_RELAY_API_KEY=ptm_xxxxxxxxxxxxxxxxxxxxxxxx
# Operator-assigned tenant id. The operator's OBS relay confines this
# Bot's object keys to its own tenant namespace, so this MUST match the
# user id the operator bound to PHYTOMNI_RELAY_API_KEY.
PHYTOMNI_RELAY_USER_ID=your-operator-assigned-tenant-id
# Runtime license key (decrypts the shipped .env.encrypted in a
# customer image). Provide via this env var or a config/.license_key
# file; the env var wins.
PHYTOMNI_LICENSE_KEY=YOUR_LICENSE_KEY
