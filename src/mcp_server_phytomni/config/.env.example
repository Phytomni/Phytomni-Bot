# Local development: copy this file to .env and fill in real values.
#
# Resolution order at process startup (see config/settings.py):
#   1. PHYTOMNI_TESTING=1 (test suites only)
#   2. this plaintext .env (whichever you copy it to)
#   3. .env.encrypted + PHYTOMNI_LICENSE_KEY (customer-image fallback)
#
# Customer image distribution does NOT bake a plaintext .env into the
# image — .dockerignore blocks every .env / .env.* path; only
# .env.encrypted ships. Dev hosts may keep both files side by side;
# the plaintext one wins. See "Distribution to Trusted Customers" in
# README.md for the build/runtime flow and threat scope.

DOMAIN_NAME=YOUR_DOMAIN_NAME
USER_NAME=YOUR_USER_NAME
USER_PASSWORD=YOUR_USER_PASSWORD
ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
BASE_URL=YOUR_BASE_URL
MODEL_ID=YOUR_MODEL_ID
API_KEY=YOUR_API_KEY
CODER_URL=YOUR_CODER_URL
CODER_MODEL=YOUR_CODER_MODEL
CODER_API_KEY=YOUR_CODER_API_KEY
EMBED_URL=YOUR_EMBED_URL
EMBED_MODEL=YOUR_EMBED_MODEL
EMBED_API_KEY=YOUR_EMBED_API_KEY
# Direct GaussDB connection string for agents/shared/gauss.py. Required
# outside relay mode. URL-encode any @ : / in the password.
GAUSS_DSN=postgresql://USER:PASSWORD@1.95.84.152:8000/nky_science_data?sslmode=require

# Required by MCP/HTTP serving startup. Build offline and mount read-only.
# Accepts CITATION_DB_PATH or PHYTOMNI_CITATION_DB_PATH; no default.
CITATION_DB_PATH=/var/lib/phytomni/citations/reference.sqlite

# Required process-local outbound logical-pool capacities. Set a capacity to
# 0 for unlimited admission; values are per process and do not cap sockets.
OUTBOUND_LLM_CONCURRENCY=0
OUTBOUND_RETRIEVAL_CONCURRENCY=0
OUTBOUND_RERANK_CONCURRENCY=0
OUTBOUND_NL2SQL_CONCURRENCY=0
OUTBOUND_ANALYSIS_CONTROL_CONCURRENCY=0
OUTBOUND_ANALYSIS_STATUS_CONCURRENCY=0
OUTBOUND_IAM_CONCURRENCY=0
OUTBOUND_SPA_FAQ_CONCURRENCY=0
OUTBOUND_BI_CONCURRENCY=0
OUTBOUND_OBS_CONCURRENCY=0
OUTBOUND_RELAY_CONTROL_CONCURRENCY=0
OUTBOUND_INTEROP_CONCURRENCY=0
# Logs a value-safe warning when a pool wait reaches this finite positive time.
OUTBOUND_POOL_WAIT_WARN_SECONDS=1

# Server tuning (optional; has safe defaults).
# GAUSS_COMMAND_TIMEOUT bounds each direct GaussDB query in seconds.
# HTTP_MAX_CONNECTIONS / HTTP_MAX_KEEPALIVE set the shared
# httpx.AsyncClient pool limits (max total / max keepalive). Leave
# them unset to accept the defaults.
# GAUSS_COMMAND_TIMEOUT=30.0
# HTTP_MAX_CONNECTIONS=100
# HTTP_MAX_KEEPALIVE=50
# API_GRACEFUL_SHUTDOWN=30
# STREAM_ANSWER_MAX_BYTES soft-caps ChatAgent streamed-answer persistence
# in the run registry (default 1 MiB); the live SSE wire stream is never
# truncated. Accepts the unprefixed or PHYTOMNI_-prefixed form.
# PHYTOMNI_STREAM_ANSWER_MAX_BYTES=1048576
# Research input resolution uses bounded request-wide limits. These are
# operator-tunable within the hard ceilings documented in configuration.md;
# they are not a feature flag. The protocol is advertised only after direct
# or relay readiness checks pass.
# PHYTOMNI_API_MAX_USER_QUERY_CHARS=131072
# PHYTOMNI_API_MAX_ATTACHMENTS_PER_REQUEST=64
# PHYTOMNI_API_MAX_RESEARCH_DATASET_PATHS=64
# PHYTOMNI_API_MAX_RESEARCH_INPUT_REFERENCES=128
# Resumable biological-file uploads (obs-multipart-v2) keep the contract
# bounded by default. The origin and explicit browser allowlist are deployment
# values; do not put credentials or wildcard origins in either setting.
# PHYTOMNI_API_UPLOAD_V2_ORIGIN=https://bot.example.com
# PHYTOMNI_API_UPLOAD_V2_BUCKET=phytomni
# PHYTOMNI_API_UPLOAD_V2_ALLOWED_ORIGINS=["https://web.example.com"]
# PHYTOMNI_API_UPLOAD_V2_MAX_BYTES=10737418240
# PHYTOMNI_API_UPLOAD_V2_PART_SIZE_BYTES=134217728
# PHYTOMNI_API_UPLOAD_V2_MAX_PARALLEL_PARTS=4
# PHYTOMNI_API_UPLOAD_V2_CAPABILITY_TTL_SECONDS=900
# PHYTOMNI_API_UPLOAD_V2_SESSION_TTL_SECONDS=604800
# PHYTOMNI_API_UPLOAD_V2_PROVISIONAL_TTL_SECONDS=10800
# PHYTOMNI_API_UPLOAD_V2_CLEANUP_INTERVAL_SECONDS=300
# PHYTOMNI_A2UI_ENABLED=0
# PHYTOMNI_A2UI_TOOL_CALL=0
# A2A_ENABLED=0
# A2A_PUBLIC_BASE_URL=https://agent.example.com
# User-scoped memory CRUD (opt-in; local SQLite only).
# Keep disabled until the service has a persistent local volume.
MEMORY_ENABLED=0
# MEMORY_DB_PATH=.cache/phytomni/memory.sqlite

# Outbound MCP/A2A interoperability (optional; disabled by default).
# Targets and credentials are separate JSON objects: target entries contain
# only a credential_ref, while actual headers/tokens remain in the encrypted
# SensitiveConfig envelope. Both JSON strings use SecretStr-backed config
# fields so routine repr/model dumps mask target endpoints, commands, and
# credentials. Disabled mode does not parse either JSON value. Stdio command
# and args are trusted, operator-owned static configuration; validation only
# rejects obvious credential-shaped args as a defense-in-depth guard.
INTEROP_ENABLED=0
INTEROP_TARGETS=[]
INTEROP_CREDENTIALS={}

# Relay audit copies redact credential-shaped body fields and are capped
# separately from the client-facing relay request/response limits.
# RELAY_REQUEST_AUDIT_MAX_BYTES=65536

# Deployment-specific endpoints (Phase 14.3.1: required, no default).
# Per-deployment IPs / hosts used to live as defaults in
# config/defaults.py; they are now env-required so a customer image
# never ships with another customer's endpoints baked in. Set the
# PHYTOMNI_<NAME> alias instead if you prefer the prefixed form.
RETRIEVE_URL=YOUR_RETRIEVE_URL
RERANK_URL=YOUR_RERANK_URL
SPA_FAQ_URL=YOUR_SPA_FAQ_URL

# Deployment-specific UUIDs (Phase 14.3.2: required, no default).
# Per-deployment repository / workspace / subject ids used to live
# as hardcoded customer UUIDs in config/defaults.py. REPO_ID_DICT
# must be a JSON string mapping each REPO_ID UUID to its token
# budget (e.g. {"a34b...77b": 128, "ec3...b": 64}).
REPO_ID=YOUR_REPO_ID
REPO_ID_DICT=YOUR_REPO_ID_DICT_JSON
WORKSPACE_ID=YOUR_WORKSPACE_ID
SUBJECT_ID=YOUR_SUBJECT_ID
DATA_REPO_ID=YOUR_DATA_REPO_ID
TOOL_REPO_ID=YOUR_TOOL_REPO_ID
PROTOCOL_REPO_ID=YOUR_PROTOCOL_REPO_ID
SPA_REPO_ID=YOUR_SPA_REPO_ID

# Embedded-UUID URLs (required, no default).
# DATABASE_URL and ANALYSIS_URL used to embed customer workspace /
# project / job UUIDs as substrings inside the hardcoded default;
# both are now env-required so a customer image is portable across
# deployments.
DATABASE_URL=YOUR_DATABASE_URL
ANALYSIS_URL=YOUR_ANALYSIS_URL

# Cloud-platform endpoints + compute-tier app-id map (required, no
# default). TOKEN_URL and OBS_SERVER used to bake a Huawei region
# host (iam.cn-southwest-2 / obs.cn-east-3) into the wheel; APP_ID
# used to ship a hardcoded map of three compute-tier UUIDs. Ship
# APP_ID as a JSON string keyed by analyst compute tier:
# ``PHYTOMNI_APP_ID='{"small":"<uuid>","medium":"<uuid>","large":"<uuid>"}'``;
# pydantic-settings parses it into Dict[str, str] automatically.
TOKEN_URL=YOUR_TOKEN_URL
OBS_SERVER=YOUR_OBS_SERVER
APP_ID=YOUR_APP_ID_JSON
