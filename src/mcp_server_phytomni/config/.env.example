# Local development: copy this file to .env and fill in real values.
#
# Customer image distribution does NOT use a plaintext .env. Instead an
# operator seals a filled-in .env into a per-customer AES-256-GCM
# envelope (.env.encrypted) and the bot decrypts it at startup from
# PHYTOMNI_LICENSE_KEY. See "Distribution to Trusted Customers" in
# README.md for the build/runtime flow and threat scope.

DOMAIN_NAME=YOUR_DOMAIN_NAME
USER_NAME=YOUR_USER_NAME
USER_PASSWORD=YOUR_USER_PASSWORD
ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
BASE_URL=YOUR_BASE_URL
MODEL_ID=YOUR_MODEL_ID
API_KEY=YOUR_API_KEY
CODER_URL=YOUR_CODER_URL
CODER_MODEL=YOUR_CODER_MODEL
CODER_API_KEY=YOUR_CODER_API_KEY
EMBED_URL=YOUR_EMBED_URL
EMBED_MODEL=YOUR_EMBED_MODEL
EMBED_API_KEY=YOUR_EMBED_API_KEY
BI_TOKEN=YOUR_BI_TOKEN
