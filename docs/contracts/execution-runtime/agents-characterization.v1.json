{
  "schema_version": 1,
  "comparison_policy": {
    "exact": [
      "public tool and slug",
      "validation outcome and safe error classification",
      "selected domain handler",
      "tool/provider operation identities",
      "branch and join decisions",
      "result and artifact schemas",
      "conversation-context mutations"
    ],
    "normalized": [
      "prompt/template identity",
      "query transformation",
      "model-generated answer invariants",
      "follow-up question invariants"
    ],
    "excluded": [
      "timestamps",
      "generated ids",
      "token boundaries",
      "execution lifecycle events added by V2",
      "nondeterministic prose equality"
    ]
  },
